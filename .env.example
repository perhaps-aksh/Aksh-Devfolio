# Copy this file to .env for local development (npm run dev) or .dev.vars for `wrangler dev`.
# In production, set these in the Cloudflare dashboard under Workers & Pages → Settings → Variables.
# Never commit the real file — .env, .env.*.local and .dev.vars are already git-ignored.

# --- Supabase --------------------------------------------------------------------------------------
# Project URL and keys, from your Supabase project's Settings → API.
SUPABASE_URL=https://your-project.supabase.co
# Public/anon key. Used for published content, the contact form and page-view tracking (Row Level
# Security applies). Safe to expose, but this app only ever uses it on the server.
SUPABASE_ANON_KEY=
# Secret/service-role key. Bypasses Row Level Security. Used ONLY by the admin area, after the admin
# session is verified. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login -------------------------------------------------------------------------------------
ADMIN_ID=admin
# Either set a plain password (simplest)...
ADMIN_PASSWORD=change-me
# ...or generate a hash instead so the plain password is never stored anywhere (recommended):
#   npm run admin:hash
# then set ADMIN_PASSWORD_HASH to its output and remove ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# Recommended: a random string of 32+ characters, used to sign admin login sessions. Generate one with
# `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Without this, a key is derived from the admin credentials instead (still secure, but rotating the
# password becomes the only way to invalidate sessions).
ADMIN_SESSION_SECRET=

# --- Optional ------------------------------------------------------------------------------------------
# Your public domain, used for canonical links, Open Graph URLs and the sitemap. Falls back to the
# request's own origin when unset.
# SITE_URL=https://aksh.dev
# Salt for the anonymous page-view visitor hash. Falls back to ADMIN_SESSION_SECRET / SUPABASE_URL.
# ANALYTICS_SALT=
# The contact form relays messages to https://formsubmit.co/ajax/<email>, using the contact email set
# in the admin area under Personalize -> About & contact (no signup needed; FormSubmit sends a one-time
# confirmation email the first time a given address is used). Only override this for local testing
# against a fake endpoint.
# FORMSUBMIT_BASE=https://formsubmit.co
